# Pin this to an immutable release or sha-<commit> tag for production rollout.
SECURE_IMAGE_TAG=latest

# New TrueNAS datasets used only by Evergreen Endpoint | SECURE.
SECURE_DATA_ROOT=/mnt/NVME/evergreen-endpoint-secure

# Existing secure.technicull.ca reverse-proxy contract.
YOPASS_BIND_ADDRESS=127.0.0.1
YOPASS_PORT=1337
YOPASS_PUBLIC_URL=https://secure.technicull.ca
YOPASS_PRIVACY_URL=https://technicull.ca/privacy.html

YOPASS_REDIS_MAXMEMORY=256mb
YOPASS_MAX_FILE_SIZE=1MB
YOPASS_DEFAULT_EXPIRY=1h
YOPASS_FORCE_EXPIRATION=1h
